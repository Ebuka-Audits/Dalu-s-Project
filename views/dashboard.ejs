<%- include('partials/head', { title: 'Dashboard' }) %>
<body>
  <%- include('partials/nav') %>
  <main class="wrap">
    <div class="page-head">
      <h1 class="page-title">Dashboard</h1>
      <div class="row wrap-row">
        <label class="inline">Month <input type="month" id="month"></label>
        <a class="btn ghost" id="pdfLink" href="/api/report.pdf">PDF report</a>
      </div>
    </div>

    <section class="stats">
      <div class="balance">
        <span class="label">Total balance</span>
        <strong id="balance">₦0.00</strong>
        <span class="sub">All income minus all spending, all time</span>
      </div>
      <div class="stat"><span class="label">Income this month</span><strong id="income" class="pos">₦0.00</strong></div>
      <div class="stat"><span class="label">Spending this month</span><strong id="expense" class="neg">₦0.00</strong></div>
    </section>

        <section class="panel">
      <div class="panel-head">
        <h2>Net worth</h2>
        <a class="btn ghost small" href="/portfolio">Portfolio</a>
      </div>
      <div id="nwStats" class="mk-stats"></div>
      <div id="nwBar" class="nw-bar" role="img" aria-label="Share of net worth by type" hidden></div>
      <p id="nwMsg" class="empty" hidden>Loading…</p>
    </section>

    <section class="charts">
      <div class="panel">
        <h2>Last 6 months</h2>
        <div class="chart-box"><canvas id="barChart" aria-label="Income and spending by month" role="img"></canvas></div>
      </div>
      <div class="panel">
        <h2>Where it went</h2>
        <div class="chart-box"><canvas id="pieChart" aria-label="Spending by category" role="img"></canvas></div>
        <p id="pieEmpty" class="empty" hidden>No spending recorded this month.</p>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Recent transactions</h2>
        <a class="btn ghost small" href="/transactions">View all</a>
      </div>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Date</th><th>Category</th><th>Note</th><th class="num">Amount</th></tr></thead>
          <tbody id="recentBody"></tbody>
        </table>
      </div>
      <p id="recentEmpty" class="empty" hidden>No transactions this month. <a href="/transactions">Add one</a>.</p>
    </section>
  </main>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="/js/common.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>